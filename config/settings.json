{
  "ui": {
    "base_url": "https://www.kinopoisk.ru",
    "search_path": "/s/",
    "timeout_ms": 15000,
    "navigation_timeout_ms": 45000,
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "selectors": {
      "advanced_title": "input[name=\"m_act[find]\"]",
      "header_title": "input[name=\"kp_query\"]",
      "year": "select[name=\"m_act[year]\"]",
      "type": "select[name=\"m_act[what]\"]",
      "results": ".search_results .element",
      "result_title": ".info .name a",
      "result_year": ".info .year",
      "poster": "[data-tid=\"film-poster\"], img[class*=\"film-poster\"], img[alt*=\"Постер\"]",
      "description": "[data-tid=\"movie-description\"], [class*=\"film-synopsis\"], [class*=\"styles_synopsis\"]"
    }
  },
  "api": {
    "base_url": "https://api.poiskkino.dev/v1.5",
    "timeout_seconds": 20,
    "invalid_token": "invalid_test_token"
  }
}
